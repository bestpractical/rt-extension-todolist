<&| /Elements/LabeledValue, Label => '' &>
  <div class="form-check">
    <input type="checkbox" class="form-check-input" id="TodoListCustomField" name="TodoListCustomField" value="1" <% $TodoListCustomField |n %> />
    <label class="form-check-label" for="TodoListCustomField">
      <&|/l&>Todo List (Check to apply this custom field as a todo list)</&>
    </label>
  </div>
</&>
<%init>
return unless $CustomField->Id;

my $TodoListCustomField = '';
$TodoListCustomField = qq[checked="checked"] if $CustomField->FirstAttribute('TodoListCustomField');
</%init>
<%args>
$CustomField
</%args>
