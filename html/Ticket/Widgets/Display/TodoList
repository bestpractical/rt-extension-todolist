%  if ( $custom_fields->Count ) {
    <& /Elements/TodoList, Object => $TicketObj &>
%  }
<%init>
return unless $TicketObj;

my $custom_fields = RT::CustomFields->new($session{'CurrentUser'});
$custom_fields->LimitTodoToObject($TicketObj->QueueObj->Id);
</%init>
<%args>
$TicketObj  => undef
</%args>
